# Backend settings for local development. Copy to `.env` (repo root or backend/).
# Every variable is optional locally; see docs/ENVIRONMENT.md for details.
# The frontend has its own file: frontend/.env.example.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Empty = local SQLite file at backend/recoverx.db. Docker Compose uses PostgreSQL.
DATABASE_URL=

# Seeds 1,000 customers / 500 cases on first start and creates demo logins
# (admin@recoverx.local / recoverx-demo). Demo logins are never created in production.
SEED_DEMO_DATA=true

CORS_ORIGINS=http://localhost:3000
AUTH_SECRET=
AUTH_REQUIRED=true
# Encrypts merchants' stored Razorpay secrets. Locally it falls back to one derived from AUTH_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# Optional: an administrator account created (or re-synced) at startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Razorpay account id that signed webhooks are routed to.
BOOTSTRAP_RAZORPAY_ACCOUNT_ID=acct_local_demo

# Merchants normally add their own Razorpay test keys under Integrations. These legacy settings
# apply only to the primary merchant (BOOTSTRAP_RAZORPAY_ACCOUNT_ID). Test keys (rzp_test_) only.
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false

TEMPORAL_ENABLED=false
TEMPORAL_HOST=localhost:7233

# Recovery advisor: rules (deterministic, default) or anthropic (Claude). See docs/AI.md.
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Observability
SENTRY_DSN=
LOG_FORMAT=text
