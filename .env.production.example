# Production backend settings. Store these in your host's secret manager, never in git.
# The API refuses to start in production if a required value is missing or a
# development default is still in place. See docs/ENVIRONMENT.md and docs/DEPLOYMENT.md.

ENVIRONMENT=production

# Required
DATABASE_URL=postgresql://user:password@host:5432/recoverx
AUTH_SECRET=                      # python -c "import secrets; print(secrets.token_urlsafe(48))"
CREDENTIALS_ENCRYPTION_KEY=       # same command; never change it once merchants have stored keys
RAZORPAY_WEBHOOK_SECRET=          # Razorpay Dashboard → Settings → Webhooks
BOOTSTRAP_ADMIN_EMAIL=ops@your-company.com
BOOTSTRAP_ADMIN_PASSWORD=         # 16+ characters
BOOTSTRAP_RAZORPAY_ACCOUNT_ID=    # acc_... from the Razorpay Dashboard
CORS_ORIGINS=https://your-frontend.example.com

# Legacy single-merchant keys for the primary merchant only; merchants can instead store their
# own keys under Integrations. Keep "simulated" until test-mode keys are configured.
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=                  # rzp_test_... (test mode only)
RAZORPAY_KEY_SECRET=
ALLOW_LIVE_PAYMENTS=false         # live keys stay refused unless explicitly authorized

# Demo data stays off in production; demo logins are never created there.
SEED_DEMO_DATA=false
LOG_LEVEL=INFO

# Recovery advisor: rules (deterministic, default) or anthropic (Claude). See docs/AI.md.
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Observability
SENTRY_DSN=
